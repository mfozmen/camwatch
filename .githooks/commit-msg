#!/usr/bin/env bash
#
# Conventional Commits check. A regex rather than commitlint: one line to check
# does not need two dependencies and a config file.
set -euo pipefail

subject="$(head -1 "$1")"

# Merge commits, reverts and fixups are generated by git, not typed by a human.
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<MSG

✗ commit-msg: not a Conventional Commit

  got:      $subject
  expected: <type>[(scope)][!]: <description>
  types:    feat fix docs style refactor perf test build ci chore revert

MSG
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  printf '\n✗ commit-msg: subject is %s characters, keep it under 72\n\n' "${#subject}" >&2
  exit 1
fi
